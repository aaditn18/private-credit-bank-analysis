# Configuration for the chatbot app — read by pc_analyst.config.Settings.
# Copy this file to `.env` (same directory) and fill in real values.
# Resolved at backend startup; restart uvicorn after editing.

# ── Storage ────────────────────────────────────────────────────────────
# 'sqlite' is the only path tested locally. The DB lives at SQLITE_PATH;
# DATABASE_URL is ignored on the SQLite path but kept for parity.
STORAGE_BACKEND=sqlite
DATABASE_URL=postgresql://pc:pc@localhost:5432/pc_analyst
SQLITE_PATH=./backend/pc_analyst.db

# ── Embeddings + reranker ──────────────────────────────────────────────
# 'local' = sentence-transformers MiniLM (downloaded on first run, ~90MB).
# Reranker is bge-reranker-base (~440MB) on first run.
EMBEDDING_MODEL=local
EMBEDDING_DIM=384
RERANKER_MODEL=BAAI/bge-reranker-base

# ── LLM provider ───────────────────────────────────────────────────────
# Used by: chatbot answers, Compare-page winner summary, populate_findings.py.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── External feeds ─────────────────────────────────────────────────────
# Alpha Vantage NEWS_SENTIMENT — feeds the /news/{ticker} sidebar on the
# timeline page. Free tier = 25 req/day; results are cached to SQLite.
ALPHAVANTAGE_API_KEY=

# Identifies you to SEC EDGAR. Used by ingest_filings.py / expand_banks.py.
SEC_USER_AGENT=private-credit-analyst your.email@example.com

# FFIEC CDR Public Web Service — only used by scripts/fetch_missing_pws.py
# (private wealth schedules). The main load_call_reports.py script reads
# pre-downloaded CSVs from Call_Reports/ and does not need these.
# Free signup: https://cdr.ffiec.gov/public/PWS/Login.aspx
FFIEC_USERNAME=
FFIEC_TOKEN=

# ── HTTP ───────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
