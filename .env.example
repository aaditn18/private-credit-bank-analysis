# Configuration for the LEGACY analysis pipelines only:
#   - Keyword_match_method/
#   - Semantic_similarity_method/
#   - combined_code/
#
# The chatbot app does NOT read this file. Copy this to `.env` and fill in
# the key only if you intend to run the legacy pipelines. To run the app
# alone, populate `bank-analysis-ai-chatbot/.env` instead.

# Single key — used by the Gemini path in pipeline_core.py / secondary_analysis.py
GEMINI_API_KEY=

# Optional second/third key for round-robin if you hit per-key rate limits.
# Comma-separated list. The pipelines fall back to GEMINI_API_KEY if unset.
# GEMINI_API_KEYS=key1,key2,key3
